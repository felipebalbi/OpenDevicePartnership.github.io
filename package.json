{
  "name": "odp-website-styles",
  "version": "0.1.0",
  "private": true,
  "description": "Build pipeline for the ODP website. UnoCSS scans src/**/*.rs for uno![...] invocations and emits style/uno.generated.css; scripts/build-assets.js then minifies + assembles the static deploy tree under target/site/.",
  "scripts": {
    "build:css": "unocss --config unocss.config.ts --out-file style/uno.generated.css \"src/**/*.rs\" && node scripts/concat-css.js",
    "watch:css": "unocss --config unocss.config.ts --out-file style/uno.generated.css --watch \"src/**/*.rs\"",
    "build:assets": "node scripts/build-assets.js"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@unocss/cli": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-wind3": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "lightningcss": "^1.27.0",
    "terser": "^5.47.1",
    "unocss": "^66.6.8"
  }
}
